---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  twitterImage?: string;
  canonical?: string;
}

const {
  title = "Reelcraft — Turn Code Into High-Retention 9:16 Vertical Viral Videos",
  description = "Intelligent AI Agent Skill & Standalone CLI engine that transforms code repositories, technical posts, and CLI tools into studio-grade 9:16 vertical videos in 60fps.",
  image = "/reelcraft/og-image.png",
  twitterImage = "/reelcraft/twitter-image.png",
  canonical = Astro.url.href
} = Astro.props;

const siteUrl = "https://dusmamud.github.io/reelcraft";
const absoluteImageUrl = image.startsWith('http') ? image : `https://dusmamud.github.io${image}`;
const absoluteTwitterImageUrl = twitterImage.startsWith('http') ? twitterImage : `https://dusmamud.github.io${twitterImage}`;

const currentPath = Astro.url.pathname;
const base = "/reelcraft";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <meta name="theme-color" content="#06080E">
  <meta name="msapplication-TileColor" content="#06080E">

  <!-- Favicon and App Icons -->
  <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`}>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`}>
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`}>
  <link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48.png`}>
  <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96.png`}>
  <link rel="icon" type="image/png" sizes="192x192" href={`${base}/icon-192.png`}>
  <link rel="icon" type="image/png" sizes="512x512" href={`${base}/icon-512.png`}>
  <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`}>
  <link rel="manifest" href={`${base}/site.webmanifest`}>
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title}>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={absoluteImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonical}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={absoluteTwitterImageUrl}>
  <meta property="twitter:creator" content="@dusmamud">


  <!-- JSON-LD Structured Data for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Reelcraft",
    "operatingSystem": "Cross-platform",
    "applicationCategory": "DeveloperApplication",
    "description": description,
    "url": siteUrl,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@type": "Person",
      "name": "Dus Mamud",
      "url": "https://github.com/dusmamud"
    }
  })} />
</head>
<body class="bg-[#06080E] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-purple-600 selection:text-white">

  <!-- Header Navigation -->
  <header class="sticky top-0 z-50 bg-[#06080E]/90 backdrop-blur-xl border-b border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Logo -->
      <a href={`${base}/`} class="flex items-center gap-3 group">
        <img src={`${base}/assets/reelcraft.png`} alt="Reelcraft" class="h-7 w-auto object-contain transition-opacity group-hover:opacity-90">
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-8">
        <a href={`${base}/`} class={`text-sm font-medium transition-colors ${currentPath === `${base}` || currentPath === `${base}/` ? 'text-white border-b-2 border-purple-500 pb-1' : 'text-slate-400 hover:text-white'}`}>Showcase</a>
        <a href={`${base}/how-to-use`} class={`text-sm font-medium transition-colors ${currentPath.includes('how-to-use') ? 'text-white border-b-2 border-purple-500 pb-1' : 'text-slate-400 hover:text-white'}`}>How To Use</a>
        <a href={`${base}/docs`} class={`text-sm font-medium transition-colors ${currentPath.includes('docs') ? 'text-white border-b-2 border-purple-500 pb-1' : 'text-slate-400 hover:text-white'}`}>Docs & Help</a>
        <a href={`${base}/gallery`} class={`text-sm font-medium transition-colors ${currentPath.includes('gallery') ? 'text-white border-b-2 border-purple-500 pb-1' : 'text-slate-400 hover:text-white'}`}>Video Gallery</a>
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a href="https://github.com/dusmamud/reelcraft" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-xs font-semibold text-slate-200 transition-all hover:border-white/20">
          <svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Star on GitHub</span>
        </a>
        <a href={`${base}/docs`} class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-xs font-semibold text-white shadow-sm transition-all">
          <span>Get Started</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Animated Mobile Hamburger Button -->
      <button
        class="md:hidden relative w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-300 hover:text-white transition-all focus:outline-none"
        id="mobileMenuBtn"
        aria-label="Toggle navigation"
        aria-expanded="false"
      >
        <span class="w-5 h-0.5 bg-current rounded-full transition-transform duration-300 origin-center" id="bar1"></span>
        <span class="w-5 h-0.5 bg-current rounded-full transition-opacity duration-300" id="bar2"></span>
        <span class="w-5 h-0.5 bg-current rounded-full transition-transform duration-300 origin-center" id="bar3"></span>
      </button>
    </div>

    <!-- Animated Mobile Menu Drawer -->
    <div
      id="mobileDrawer"
      class="md:hidden overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out bg-[#090C15] border-b border-white/[0.08]"
    >
      <div class="px-5 pt-3 pb-6 flex flex-col gap-2">
        <!-- Showcase Link -->
        <a href={`${base}/`} class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-200 hover:bg-white/[0.05] hover:text-white transition-all">
          <svg class="w-4 h-4 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>Showcase</span>
        </a>

        <!-- How To Use Link -->
        <a href={`${base}/how-to-use`} class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-200 hover:bg-white/[0.05] hover:text-white transition-all">
          <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          <span>How To Use</span>
        </a>

        <!-- Docs & Help Link -->
        <a href={`${base}/docs`} class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-200 hover:bg-white/[0.05] hover:text-white transition-all">
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>Docs & Help</span>
        </a>

        <!-- Video Gallery Link -->
        <a href={`${base}/gallery`} class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-200 hover:bg-white/[0.05] hover:text-white transition-all">
          <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
            <line x1="7" y1="2" x2="7" y2="22"></line>
            <line x1="17" y1="2" x2="17" y2="22"></line>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <line x1="2" y1="7" x2="7" y2="7"></line>
            <line x1="2" y1="17" x2="7" y2="17"></line>
            <line x1="17" y1="17" x2="22" y2="17"></line>
            <line x1="17" y1="7" x2="22" y2="7"></line>
          </svg>
          <span>Video Gallery</span>
        </a>

        <div class="pt-3 border-t border-white/[0.06] flex flex-col gap-2 mt-1">
          <a href="https://github.com/dusmamud/reelcraft" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between px-3 py-2.5 rounded-lg bg-white/[0.03] border border-white/[0.06] text-xs font-semibold text-slate-200">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>GitHub Repository</span>
            </span>
            <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
          <a href={`${base}/docs`} class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-xs font-semibold text-white shadow-sm transition-all mt-1">
            <span>Get Started</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Page Slot -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Global Footer -->
  <footer class="bg-[#030408] border-t border-white/[0.08] pt-14 pb-8 mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div class="md:col-span-2">
          <img src={`${base}/assets/reelcraft.png`} alt="Reelcraft" class="h-6 w-auto mb-4">
          <p class="text-sm text-slate-400 max-w-sm mb-4 leading-relaxed">
            You built the code. Now make it go viral. The open-source 9:16 vertical video engine engineered with Hyperframes.
          </p>
          <div class="flex flex-wrap gap-2 text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-purple-950/60 border border-purple-700/50 text-purple-300 font-semibold">MIT License</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-700 text-slate-300">Hyperframes 60fps</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-700 text-slate-300">Kokoro + Edge-TTS</span>
          </div>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">Navigation</h4>
          <ul class="space-y-2.5 text-sm text-slate-400">
            <li><a href={`${base}/`} class="hover:text-white transition-colors">Showcase</a></li>
            <li><a href={`${base}/how-to-use`} class="hover:text-white transition-colors">How To Use</a></li>
            <li><a href={`${base}/docs`} class="hover:text-white transition-colors">Documentation</a></li>
            <li><a href={`${base}/gallery`} class="hover:text-white transition-colors">Video Gallery</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">Author & Project</h4>
          <p class="text-sm text-slate-400 mb-2">
            Created by <strong class="text-white">Dus Mamud</strong>
          </p>
          <p class="text-sm text-slate-400 mb-4">
            <a href="mailto:dusmamud0@gmail.com" class="text-purple-400 hover:underline">dusmamud0@gmail.com</a>
          </p>
          <a href="https://github.com/dusmamud/reelcraft" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-white/[0.06] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-mono text-purple-300 transition-colors">
            <span>github.com/dusmamud/reelcraft</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>

      <div class="border-t border-white/[0.05] pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
        <p>© {new Date().getFullYear()} Reelcraft. Released under the MIT License.</p>
        <p>Built for the modern AI & Open Source developer ecosystem.</p>
      </div>
    </div>
  </footer>

  <!-- Interactive Mobile Navigation Script -->
  <script>
    function setupMobileMenu() {
      const btn = document.getElementById('mobileMenuBtn');
      const drawer = document.getElementById('mobileDrawer');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');

      if (!btn || !drawer) return;

      let isOpen = false;

      function toggle() {
        isOpen = !isOpen;
        btn?.setAttribute('aria-expanded', String(isOpen));

        if (isOpen) {
          drawer?.classList.remove('max-h-0', 'opacity-0');
          drawer?.classList.add('max-h-96', 'opacity-100');
          bar1?.classList.add('rotate-45', 'translate-y-2');
          bar2?.classList.add('opacity-0');
          bar3?.classList.add('-rotate-45', '-translate-y-2');
        } else {
          drawer?.classList.remove('max-h-96', 'opacity-100');
          drawer?.classList.add('max-h-0', 'opacity-0');
          bar1?.classList.remove('rotate-45', 'translate-y-2');
          bar2?.classList.remove('opacity-0');
          bar3?.classList.remove('-rotate-45', '-translate-y-2');
        }
      }

      btn.addEventListener('click', toggle);

      // Close drawer when clicking any link inside it
      drawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          if (isOpen) toggle();
        });
      });
    }

    // Run on initial load and view transitions
    setupMobileMenu();
    document.addEventListener('astro:page-load', setupMobileMenu);
  </script>
</body>
</html>
