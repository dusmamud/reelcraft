---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeHeroPhone from '../components/ThreeHeroPhone';
import CommandBuilder from '../components/CommandBuilder';

const base = "/reelcraft";
---

<BaseLayout
  title="Reelcraft — Turn Code Into High-Retention 9:16 Vertical Viral Videos"
  description="Intelligent AI Agent Skill & Standalone CLI engine that transforms code repositories, technical posts, and CLI tools into studio-grade 9:16 vertical videos in 60fps."
>
  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 lg:pt-16 lg:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Left Copy Column -->
      <div class="lg:col-span-7 flex flex-col items-start">
        <div class="flex flex-wrap items-center gap-2 mb-6">
          <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-semibold bg-purple-950/60 border border-purple-700/50 text-purple-300">
            9:16 Vertical Video Engine
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-semibold bg-cyan-950/60 border border-cyan-700/50 text-cyan-300">
            Hyperframes 60fps
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
          You built the code.<br>
          Now make it <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-violet-300 to-pink-400">go viral</span>.
        </h1>

        <p class="text-base sm:text-lg text-slate-400 max-w-xl mb-8 leading-relaxed">
          Transform any codebase, technical launch, or blog post into studio-grade <strong>9:16 vertical videos</strong> for TikTok, Instagram Reels, and YouTube Shorts in seconds.
        </p>

        <div class="flex flex-wrap items-center gap-3 mb-10">
          <a href={`${base}/docs`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-sm font-semibold text-white transition-all shadow-sm">
            <span>Install Skill & CLI</span>
            <span>→</span>
          </a>
          <a href={`${base}/gallery`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-sm font-semibold text-slate-200 transition-all">
            <span>Watch 5 Video Suites</span>
          </a>
        </div>

        <!-- Supported Agents -->
        <div class="w-full pt-6 border-t border-white/[0.08]">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 mb-3 block">Supported Environments</span>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.08] text-xs font-mono text-slate-300">Google Antigravity</span>
            <span class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.08] text-xs font-mono text-slate-300">Claude Code</span>
            <span class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.08] text-xs font-mono text-slate-300">Cursor</span>
            <span class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.08] text-xs font-mono text-slate-300">OpenAI Codex</span>
            <span class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.08] text-xs font-mono text-slate-300">NPM CLI</span>
          </div>
        </div>
      </div>

      <!-- Right 3D Phone Column -->
      <div class="lg:col-span-5 w-full flex justify-center">
        <ThreeHeroPhone client:load />
      </div>
    </div>
  </section>

  <!-- 4-Beat Viral Retention Curve -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/[0.08]">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-amber-400 mb-2 block">Algorithmic Science</span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4">The 4-Beat Viral Retention Curve</h2>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Social media algorithms harshly penalize videos that drop viewers in the first 3 seconds. Reelcraft enforces an algorithmic storyboard built for 85%+ completion rates.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <!-- Beat 1 -->
      <div class="dev-card p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold text-purple-400">0.0s – 3.5s</span>
            <span class="px-2 py-0.5 rounded bg-purple-950/60 border border-purple-700/40 text-[10px] font-mono font-bold text-purple-300">BEAT 1</span>
          </div>
          <h3 class="text-base font-bold text-white mb-2">The Pattern Interrupt</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Giant typographic slam, high-contrast headline, and heavy bass drop. Stops the swipe cold in under 400 milliseconds.
          </p>
        </div>
        <div class="pt-3 border-t border-white/[0.06] text-center text-xs font-mono text-emerald-400">
          88.4% Hold Rate
        </div>
      </div>

      <!-- Beat 2 -->
      <div class="dev-card p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold text-cyan-400">3.5s – 8.0s</span>
            <span class="px-2 py-0.5 rounded bg-cyan-950/60 border border-cyan-700/40 text-[10px] font-mono font-bold text-cyan-300">BEAT 2</span>
          </div>
          <h3 class="text-base font-bold text-white mb-2">Problem Agitation</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Strikethrough legacy workflows, highlight hours wasted on manual debugging, and tease the architectural breakthrough.
          </p>
        </div>
        <div class="pt-3 border-t border-white/[0.06] text-center text-xs font-mono text-cyan-400">
          Curiosity Anchor
        </div>
      </div>

      <!-- Beat 3 -->
      <div class="dev-card p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold text-emerald-400">8.0s – 18.0s</span>
            <span class="px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-700/40 text-[10px] font-mono font-bold text-emerald-300">BEAT 3</span>
          </div>
          <h3 class="text-base font-bold text-white mb-2">Live Code Proof</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Real-time terminal execution, syntax-highlighted code windows, and dynamic 10x metric counter pops.
          </p>
        </div>
        <div class="pt-3 border-t border-white/[0.06] text-center text-xs font-mono text-emerald-400">
          Visual Authority
        </div>
      </div>

      <!-- Beat 4 -->
      <div class="dev-card p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold text-amber-400">18.0s – 25.0s</span>
            <span class="px-2 py-0.5 rounded bg-amber-950/60 border border-amber-700/40 text-[10px] font-mono font-bold text-amber-300">BEAT 4</span>
          </div>
          <h3 class="text-base font-bold text-white mb-2">Viral Outro & CTA</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Seamless loop back to Beat 1, official GitHub star badge, and an authentic call-to-action that drives comments.
          </p>
        </div>
        <div class="pt-3 border-t border-white/[0.06] text-center text-xs font-mono text-amber-400">
          Loop Completion
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Command Builder Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/[0.08]">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-purple-400 mb-2 block">Quick Execution</span>
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3">Generate Video With One Command</h2>
      <p class="text-slate-400 text-sm">
        Configure flags in real-time or pass any autonomous topic prompt directly.
      </p>
    </div>

    <CommandBuilder client:visible />
  </section>

  <!-- Real Rendered Video Showcase -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/[0.08]">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-400 mb-2 block">100% Real Renders</span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4">Real Rendered 1080×1920 MP4s</h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Zero placeholders. Every test suite outputs 100% finished, beat-synced 60fps MP4 videos with audio narration and sound design.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Card 1 -->
      <div class="dev-card overflow-hidden flex flex-col">
        <div class="relative w-full aspect-[9/16] max-h-[380px] bg-black">
          <video
            src={`${base}/tests/01-vertical-tech-explainer/video.mp4`}
            poster={`${base}/tests/01-vertical-tech-explainer/poster.jpg`}
            controls
            playsinline
            preload="metadata"
            class="w-full h-full object-cover"
          />
          <span class="absolute top-3 right-3 bg-black/80 px-2 py-0.5 rounded text-[11px] font-mono font-semibold text-white">30.0s</span>
        </div>
        <div class="p-5 flex flex-col flex-grow justify-between">
          <div>
            <span class="text-[11px] font-mono font-semibold text-purple-400 uppercase">Tech Explainer</span>
            <h4 class="text-base font-bold text-white mt-1 mb-2">Physical AI & Humanoids (2026)</h4>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              Dark mode cyber-grid, Kokoro-82M AI voiceover, and dynamic audio waveform surges.
            </p>
          </div>
          <a href={`${base}/tests/01-vertical-tech-explainer/video.mp4`} download class="inline-flex items-center justify-center gap-2 py-2 px-3 rounded bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-xs font-semibold text-slate-200 transition-colors">
            <span>Download MP4 (10.7 MB)</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="dev-card overflow-hidden flex flex-col">
        <div class="relative w-full aspect-[9/16] max-h-[380px] bg-black">
          <video
            src={`${base}/tests/02-vertical-saas-studio-launch/video.mp4`}
            poster={`${base}/tests/02-vertical-saas-studio-launch/poster.jpg`}
            controls
            playsinline
            preload="metadata"
            class="w-full h-full object-cover"
          />
          <span class="absolute top-3 right-3 bg-black/80 px-2 py-0.5 rounded text-[11px] font-mono font-semibold text-white">30.0s</span>
        </div>
        <div class="p-5 flex flex-col flex-grow justify-between">
          <div>
            <span class="text-[11px] font-mono font-semibold text-amber-400 uppercase">SaaS Launch</span>
            <h4 class="text-base font-bold text-white mt-1 mb-2">StepGaana AI Music Studio</h4>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              Paper & Ink aesthetic, flagship soundtrack beat-matching, and high-conversion CTA.
            </p>
          </div>
          <a href={`${base}/tests/02-vertical-saas-studio-launch/video.mp4`} download class="inline-flex items-center justify-center gap-2 py-2 px-3 rounded bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-xs font-semibold text-slate-200 transition-colors">
            <span>Download MP4 (6.6 MB)</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="dev-card overflow-hidden flex flex-col">
        <div class="relative w-full aspect-[9/16] max-h-[380px] bg-black">
          <video
            src={`${base}/tests/03-vertical-kinetic-saas-teaser/video.mp4`}
            poster={`${base}/tests/03-vertical-kinetic-saas-teaser/poster.jpg`}
            controls
            playsinline
            preload="metadata"
            class="w-full h-full object-cover"
          />
          <span class="absolute top-3 right-3 bg-black/80 px-2 py-0.5 rounded text-[11px] font-mono font-semibold text-white">20.0s</span>
        </div>
        <div class="p-5 flex flex-col flex-grow justify-between">
          <div>
            <span class="text-[11px] font-mono font-semibold text-emerald-400 uppercase">Kinetic Teaser</span>
            <h4 class="text-base font-bold text-white mt-1 mb-2">20-Second Sprint Cut</h4>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              Sub-frame beat synchronization, rapid mode card swaps, and full Kenney UI SFX suite.
            </p>
          </div>
          <a href={`${base}/tests/03-vertical-kinetic-saas-teaser/video.mp4`} download class="inline-flex items-center justify-center gap-2 py-2 px-3 rounded bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-xs font-semibold text-slate-200 transition-colors">
            <span>Download MP4 (5.9 MB)</span>
            <span>↓</span>
          </a>
        </div>
      </div>
    </div>

    <div class="text-center mt-10">
      <a href={`${base}/gallery`} class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-sm font-semibold text-white transition-all">
        <span>View All 5 Production Suites (Including 16:9 Widescreen) ↗</span>
      </a>
    </div>
  </section>

  <!-- Safe-Zone Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/[0.08]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-emerald-400 mb-2 block">Mobile Safe-Zone Architecture</span>
        <h2 class="text-3xl font-bold tracking-tight text-white mb-4">100% Guaranteed Unobstructed Layout</h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed mb-6">
          Most video tools fail because critical code and captions get covered by Instagram's like button, comment input, or music marquee. Reelcraft guarantees mathematical safe-zones:
        </p>

        <div class="space-y-3 font-mono text-xs">
          <div class="flex justify-between items-center p-3 bg-white/[0.03] border border-white/[0.08] rounded-md">
            <span class="text-slate-300 font-semibold">Top Safe-Zone</span>
            <span class="text-slate-400">140px (Notch & Story controls)</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-white/[0.03] border border-white/[0.08] rounded-md">
            <span class="text-slate-300 font-semibold">Bottom Safe-Zone</span>
            <span class="text-slate-400">280px (Caption & Audio marquee)</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-white/[0.03] border border-white/[0.08] rounded-md">
            <span class="text-slate-300 font-semibold">Right Safe-Zone</span>
            <span class="text-slate-400">160px (Like & Share stack)</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-white/[0.03] border border-white/[0.08] rounded-md">
            <span class="text-slate-300 font-semibold">Max Speech Pace</span>
            <span class="text-slate-400">145 WPM (Comfortable reading speed)</span>
          </div>
        </div>
      </div>

      <div class="flex justify-center">
        <div class="w-64 h-[440px] rounded-[36px] border-2 border-slate-700 bg-[#030408] p-3 flex flex-col relative overflow-hidden shadow-2xl">
          <div class="h-14 bg-red-500/10 border-b border-dashed border-red-500/40 text-[10px] font-mono font-bold text-red-400 flex items-center justify-center text-center">
            Top Bar (140px Protected)
          </div>
          <div class="flex-grow flex items-center justify-center bg-emerald-500/5 p-3">
            <div class="border border-emerald-500/50 bg-emerald-500/10 rounded-lg p-3 text-center">
              <span class="text-emerald-400 font-mono font-bold text-xs">LIVE CODE AREA</span>
              <p class="text-[10px] text-emerald-300 mt-1">100% Protected</p>
            </div>
          </div>
          <div class="absolute right-0 top-14 bottom-24 w-12 bg-amber-500/10 border-l border-dashed border-amber-500/40 text-[9px] font-mono text-amber-400 flex items-center justify-center [writing-mode:vertical-rl]">
            Like / Share Bar
          </div>
          <div class="h-24 bg-red-500/10 border-t border-dashed border-red-500/40 text-[10px] font-mono font-bold text-red-400 flex items-center justify-center text-center">
            Caption & Music (280px Protected)
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
