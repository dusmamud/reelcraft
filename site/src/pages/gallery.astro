---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = "/reelcraft";

const SUITES = [
  {
    id: "01",
    title: "Physical AI & Humanoids (2026)",
    category: "Tech Explainer",
    format: "9:16 Vertical",
    resolution: "1080 × 1920",
    duration: "30.0s",
    size: "10.7 MB",
    theme: "Luminous Dark",
    audio: "Kokoro-82M AI Voice (English)",
    src: `${base}/tests/01-vertical-tech-explainer/video.mp4`,
    poster: `${base}/tests/01-vertical-tech-explainer/poster.jpg`,
    desc: "30-second kinetic motion explainer for DusynBlog. Features Ken Burns zoom on humanoid robot imagery, VLA model telemetry cards, and dynamic waveform audio surges."
  },
  {
    id: "02",
    title: "StepGaana AI Music Studio Launch",
    category: "SaaS Launch",
    format: "9:16 Vertical",
    resolution: "1080 × 1920",
    duration: "30.0s",
    size: "6.6 MB",
    theme: "Paper & Ink (Light Mode)",
    audio: "Flagship Track 'Call It Even' + SFX",
    src: `${base}/tests/02-vertical-saas-studio-launch/video.mp4`,
    poster: `${base}/tests/02-vertical-saas-studio-launch/poster.jpg`,
    desc: "Light-theme product launch video. Features tonearm needle drops, dynamic vinyl turntable rotation, mode card transitions, and high-converting CTA outro."
  },
  {
    id: "03",
    title: "StepGaana 20s Kinetic Teaser",
    category: "Kinetic Sprint",
    format: "9:16 Vertical",
    resolution: "1080 × 1920",
    duration: "20.0s",
    size: "5.9 MB",
    theme: "Warm Vinyl & Bronze",
    audio: "Ende Beats + Kenney UI SFX",
    src: `${base}/tests/03-vertical-kinetic-saas-teaser/video.mp4`,
    poster: `${base}/tests/03-vertical-kinetic-saas-teaser/poster.jpg`,
    desc: "High-retention sprint cut engineered for maximum swipe stoppage. Features rapid typography, beat-synced studio mode chips, and mechanical click SFX."
  },
  {
    id: "04",
    title: "StepGaana 16:9 Widescreen Showcase",
    category: "Landscape Widescreen",
    format: "16:9 Landscape",
    resolution: "1920 × 1080",
    duration: "20.0s",
    size: "2.8 MB",
    theme: "Paper & Ink Widescreen",
    audio: "Beat-Synced Soundtrack",
    src: `${base}/tests/04-landscape-saas-widescreen/video.mp4`,
    poster: `${base}/tests/04-landscape-saas-widescreen/poster.jpg`,
    desc: "Engineered specifically for YouTube desktop, Twitter/X cards, and Product Hunt galleries. Proves Reelcraft's flexibility across both 9:16 and 16:9 aspect ratios."
  },
  {
    id: "05",
    title: "AutoAgent Autonomous CLI Reel",
    category: "Autonomous Agent",
    format: "9:16 Vertical",
    resolution: "1080 × 1920",
    duration: "14.9s",
    size: "1.8 MB",
    theme: "Royal Blue & Glass",
    audio: "Shiny-Tech Music + Mechanical Typing",
    src: `${base}/tests/05-vertical-autonomous-cli-agent/video.mp4`,
    poster: `${base}/tests/05-vertical-autonomous-cli-agent/poster.jpg`,
    desc: "Simulates an autonomous AI CLI agent executing workflows in real-time. Features synchronized mechanical keystroke typing audio and Kokoro narration."
  }
];
---

<BaseLayout
  title="Real Rendered Video Showcase Gallery — Reelcraft"
  description="Explore all 5 production test suites rendered with Reelcraft, including 1080×1920 vertical reels and 16:9 widescreen showcases with direct MP4 downloads."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-400 mb-2 block">Zero Placeholders</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">Video Showcase Gallery</h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Every video below was 100% rendered with Reelcraft and Hyperframes. Watch in high-definition 60fps or download the uncompressed MP4 files.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {SUITES.map(suite => (
        <div class="dev-card overflow-hidden flex flex-col">
          <div class={`relative bg-black w-full overflow-hidden flex items-center justify-center ${suite.format.includes('16:9') ? 'aspect-video' : 'aspect-[9/16] max-h-[460px] mx-auto'}`}>
            <video
              src={suite.src}
              poster={suite.poster}
              controls
              playsinline
              preload="metadata"
              class="w-full h-full object-contain"
            />
            <div class="absolute top-3 right-3 flex gap-1.5">
              <span class="bg-black/80 backdrop-blur-sm px-2 py-0.5 rounded text-[11px] font-mono font-semibold text-white border border-white/10">{suite.duration}</span>
              <span class="bg-black/80 backdrop-blur-sm px-2 py-0.5 rounded text-[11px] font-mono font-semibold text-white border border-white/10">{suite.resolution}</span>
            </div>
          </div>

          <div class="p-6 flex flex-col flex-grow justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono font-semibold text-purple-400 uppercase">{suite.category}</span>
                <span class="text-xs font-mono text-slate-500">Suite #{suite.id}</span>
              </div>

              <h3 class="text-lg font-bold text-white mb-2">{suite.title}</h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4">{suite.desc}</p>

              <div class="flex flex-wrap gap-2 text-xs font-mono text-slate-300 mb-5">
                <span class="px-2.5 py-1 rounded bg-white/[0.04] border border-white/[0.06]">🎨 {suite.theme}</span>
                <span class="px-2.5 py-1 rounded bg-white/[0.04] border border-white/[0.06]">🎙️ {suite.audio}</span>
              </div>
            </div>

            <div class="pt-4 border-t border-white/[0.08] flex items-center gap-3">
              <a href={suite.src} download class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded bg-purple-600 hover:bg-purple-500 text-xs font-semibold text-white transition-colors">
                <span>Download MP4 ({suite.size})</span>
                <span>↓</span>
              </a>
              <a href={suite.poster} target="_blank" class="px-3 py-2 rounded bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-xs font-semibold text-slate-300 transition-colors">
                <span>View Poster</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
