---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommandBuilder from '../components/CommandBuilder';

const base = "/reelcraft";
---

<BaseLayout
  title="How To Use Reelcraft — The 4-Step Viral Video Pipeline"
  description="Master the 4-step algorithmic workflow to turn any code repository, CLI project, or topic into high-retention 9:16 vertical videos."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-purple-400 mb-2 block">Workflow Mastery</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">How To Use Reelcraft</h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Learn how Reelcraft autonomously inspects brand colors, authors high-retention 4-beat storyboards, snaps animations to music downbeats, and renders 1080×1920 MP4s.
      </p>
    </div>

    <!-- 4-Step Pipeline -->
    <div class="space-y-6 mb-16">
      <!-- Step 1 -->
      <div class="dev-card p-6 sm:p-8 flex flex-col sm:flex-row gap-6">
        <span class="font-mono text-4xl sm:text-5xl font-extrabold text-purple-500/30 shrink-0">01</span>
        <div class="flex-grow">
          <span class="text-xs font-mono font-semibold uppercase text-cyan-400 mb-1 block">Phase 1: Project Intelligence</span>
          <h2 class="text-xl font-bold text-white mb-2">Automated Theme & Brand Extraction</h2>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            When you invoke <code>/reelcraft</code> inside any repository, Reelcraft scans your codebase before generating a single line of animation:
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300 mb-5">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Theme Detection:</strong> Identifies dark-first (obsidian, terminal) or light-first (paper & ink) surfaces.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Colorgrading Palette:</strong> Extracts primary brand hex codes from CSS tokens, Tailwind configs, or SVG logos.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Vector Logos:</strong> Locates vector marks in <code>assets/</code> or <code>public/</code> and calculates optimal positioning.</span>
            </li>
          </ul>
          <div class="code-box p-3.5 text-xs text-purple-200">
            <span class="text-slate-500">// Autonomous Inspection Log</span><br>
            <code>Detected Theme: Luminous Dark (Background #06080E)</code><br>
            <code>Extracted Accents: #8B5CF6 (Brand Violet) + #06B6D4 (Cyber Cyan)</code>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="dev-card p-6 sm:p-8 flex flex-col sm:flex-row gap-6">
        <span class="font-mono text-4xl sm:text-5xl font-extrabold text-purple-500/30 shrink-0">02</span>
        <div class="flex-grow">
          <span class="text-xs font-mono font-semibold uppercase text-purple-400 mb-1 block">Phase 2: Scripting & Narration</span>
          <h2 class="text-xl font-bold text-white mb-2">4-Beat Storyboard & Studio Voiceover</h2>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            Reelcraft structures your project's story using the 4-Beat algorithmic retention curve:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-300 mb-4">
            <div class="p-3 bg-white/[0.02] border border-white/[0.06] rounded-md">
              <strong class="text-purple-300 block mb-1">Beat 1 (0.0s – 3.5s)</strong>
              Swipe-stopper hook with massive typography and impact bass drop.
            </div>
            <div class="p-3 bg-white/[0.02] border border-white/[0.06] rounded-md">
              <strong class="text-cyan-300 block mb-1">Beat 2 (3.5s – 8.0s)</strong>
              Problem agitation card striking through outdated legacy workflows.
            </div>
            <div class="p-3 bg-white/[0.02] border border-white/[0.06] rounded-md">
              <strong class="text-emerald-300 block mb-1">Beat 3 (8.0s – 18.0s)</strong>
              Live code breakthrough window with real syntax highlighting and 10x metric surge.
            </div>
            <div class="p-3 bg-white/[0.02] border border-white/[0.06] rounded-md">
              <strong class="text-amber-300 block mb-1">Beat 4 (18.0s – 25.0s)</strong>
              Branded outro with follow/star CTA and loop transition.
            </div>
          </div>
          <p class="text-xs text-slate-400">
            Narration is generated locally using <strong>Kokoro-82M</strong> (English default, zero API key required) or <strong>Edge-TTS</strong> (Hindi/Hinglish).
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="dev-card p-6 sm:p-8 flex flex-col sm:flex-row gap-6">
        <span class="font-mono text-4xl sm:text-5xl font-extrabold text-purple-500/30 shrink-0">03</span>
        <div class="flex-grow">
          <span class="text-xs font-mono font-semibold uppercase text-emerald-400 mb-1 block">Phase 3: Sub-Frame Motion</span>
          <h2 class="text-xl font-bold text-white mb-2">Kinetic Motion & Audio Beat Snapping</h2>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            Powered by Hyperframes, the video is composed directly with modern web standards:
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Sub-Frame Audio Snapping:</strong> Music downbeats and drum transients are detected, snapping card reveals precisely to the beat.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>UI Sound Design:</strong> Bundles mechanical typing sounds (keystroke clicks) and tactile interface pops.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>100% Platform Safe-Zones:</strong> Strict margins ensure zero overlay collision with social media UI.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="dev-card p-6 sm:p-8 flex flex-col sm:flex-row gap-6">
        <span class="font-mono text-4xl sm:text-5xl font-extrabold text-purple-500/30 shrink-0">04</span>
        <div class="flex-grow">
          <span class="text-xs font-mono font-semibold uppercase text-amber-400 mb-1 block">Phase 4: Production Delivery</span>
          <h2 class="text-xl font-bold text-white mb-2">1080×1920 MP4 & Social Publishing Kit</h2>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            Every run renders a self-contained output folder ready for immediate publishing:
          </p>
          <div class="code-box p-3.5 text-xs text-amber-200">
            <code>reel-output/</code><br>
            <code>├── reel.mp4 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;# 1080x1920 60fps finished H.264+AAC video</code><br>
            <code>├── poster.jpg &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;# Frame-1 high-contrast cover thumbnail</code><br>
            <code>├── captions.txt &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;# Ready-to-publish copy + 15 targeted hashtags</code><br>
            <code>├── reel-plan.md &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;# Storyboard, timestamps & voiceover script</code><br>
            <code>└── composition/ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;# Complete editable HTML/CSS/JS source</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Autonomous Topic Mode -->
    <div class="dev-card p-6 sm:p-8 mb-16 border-amber-500/30">
      <span class="text-xs font-mono font-semibold uppercase text-amber-400 mb-1 block">No Codebase Needed</span>
      <h2 class="text-2xl font-bold text-white mb-3">Autonomous Topic Mode</h2>
      <p class="text-sm text-slate-400 leading-relaxed mb-4">
        You do not even need an existing codebase. Pass any technical topic or research paper directly into the prompt:
      </p>
      <div class="space-y-2 font-mono text-xs text-amber-300">
        <div class="code-box p-3 bg-black/50"><code>/reelcraft "Physical AI & Humanoid Robotics in 2026" --voice</code></div>
        <div class="code-box p-3 bg-black/50"><code>/reelcraft "Why Vector Databases Are Taking Over LLM Memory" --tone cyberpunk</code></div>
        <div class="code-box p-3 bg-black/50"><code>/reelcraft "DeepSeek-R1 Architecture Explained in 30 Seconds" --lang hi --voice</code></div>
      </div>
    </div>

    <!-- Interactive Generator -->
    <div class="mb-12">
      <div class="text-center max-w-xl mx-auto mb-8">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-purple-400 mb-1 block">Try It Yourself</span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Configure Your Command</h2>
      </div>
      <CommandBuilder client:load />
    </div>
  </div>
</BaseLayout>
